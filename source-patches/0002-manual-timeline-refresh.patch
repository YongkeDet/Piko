@@ -0,0 +1,40 @@
+package app.morphe.extension.newx.timeline;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import org.junit.Test;
+
+/** Catches automatic/cursor refreshes bypassing the toggle while preserving initial loads and paging. */
+public final class TimelineRefreshGateTest {
+    // Deliberately shuffled: request meaning is independent of its obfuscated enum ordinal.
+    private enum Request { GAP, VIEWPORT_AWARE_AUTO_REFRESH, PULL_TO_REFRESH, NEWER_THAN, OLDER_THAN, AUTO_REFRESH, FUTURE_REFRESH }
+
+    @Test
+    public void populatedTimelinesAllowOnlyPullsAndPagination() {
+        List<?> populated = Arrays.asList(Collections.emptyList(), Collections.singletonList("post"));
+        for (Request request : Request.values()) {
+            boolean allowed = TimelineRefreshGate.shouldAllowRequest(request, populated);
+            if (request == Request.PULL_TO_REFRESH || request == Request.OLDER_THAN || request == Request.GAP) {
+                assertTrue(request.name(), allowed);
+            } else {
+                assertFalse(request.name(), allowed);
+            }
+        }
+        assertFalse(TimelineRefreshGate.shouldAllowRequest(null, populated));
+    }
+
+    @Test
+    public void initialLoadsRemainAvailableIncludingEmptyPageContainers() {
+        List<?>[] emptyStates = new List<?>[] {null, Collections.emptyList(), Arrays.asList(null, Collections.emptyList())};
+        for (List<?> pages : emptyStates) {
+            for (Request request : Request.values()) {
+                assertTrue(request.name(), TimelineRefreshGate.shouldAllowRequest(request, pages));
+            }
+            assertTrue(TimelineRefreshGate.shouldAllowRequest(null, pages));
+        }
+    }
+}
