+package app.morphe.extension.newx.misc;
+
+import java.io.IOException;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.Call;
+import okhttp3.HttpUrl;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+
+/** Reuses the host's account client and native query composer; never stores credentials on disk. */
+public final class ProfileMediaSession {
+    private static volatile Object composer;
+    private static volatile ProfileMediaSession current;
+    private final OkHttpClient client;
+    private final Request template;
+    private final Object requestComposer;
+    private final String account;
+    private volatile Call call;
+    private volatile boolean cancelled;
+
+    private ProfileMediaSession(OkHttpClient client, Request template, Object composer, String account) {
+        this.client = client;
+        this.template = template;
+        this.requestComposer = composer;
+        this.account = account;
+    }
+
+    public static void captureComposer(Object value) {
+        composer = value;
+    }
+
+    public static void captureClient(OkHttpClient client, Request request) {
+        if (request.tag(ProfileMediaSession.class) != null || composer == null) return;
+        HttpUrl url = request.url();
+        if (!"https".equals(url.scheme()) || !"api.x.com".equals(url.host())
+                || !url.encodedPath().startsWith("/graphql/")) return;
+        String operation = url.pathSegments().get(url.pathSegments().size() - 1);
+        if (!operation.startsWith("UserProfile") && !operation.startsWith("UserWithProfile")
+                && !operation.equals("GetUserQuery") && !operation.equals("GetUserByScreenNameQuery")) return;
+        // This is the host's account-bound interceptor, preserved by OkHttp client clones.
+        for (Object interceptor : client.interceptors()) {
+            String account = accountId(interceptor);
+            if (account != null && !account.equals("0")) {
+                current = new ProfileMediaSession(client, request, composer, account);
+                return;
+            }
+        }
+    }
+
+    static ProfileMediaSession snapshot() {
+        ProfileMediaSession value = current;
+        return value == null ? null : new ProfileMediaSession(value.client, value.template, value.requestComposer, value.account);
+    }
+
+    boolean isCurrent() {
+        ProfileMediaSession value = current;
+        return value != null && value.account.equals(account);
+    }
+
+    String page(String userId, String cursor) throws IOException {
+        if (cancelled || !isCurrent()) throw new IOException("Account changed or download cancelled");
+        String url = mediaUrl(requestComposer, userId, cursor);
+        HttpUrl parsed = HttpUrl.parse(url);
+        if (parsed == null || !"https".equals(parsed.scheme()) || !"api.x.com".equals(parsed.host())
+                || !parsed.encodedPath().endsWith("/UserProfileMediaTimelineQuery")) {
+            throw new IOException("Invalid native profile media request");
+        }
+        // Let the account client's authentication interceptors sign the new URL.
+        Request request = template.newBuilder().url(parsed).get()
+                .removeHeader("Authorization")
+                .removeHeader("Content-Length").removeHeader("Content-Type")
+                .removeHeader("If-None-Match").removeHeader("If-Modified-Since")
+                .header("Accept", "application/json")
+                .tag(ProfileMediaSession.class, this).build();
+        Call created = client.newBuilder().callTimeout(45, TimeUnit.SECONDS).build().newCall(request);
+        call = created;
+        if (cancelled) created.cancel();
+        try (Response response = created.execute()) {
+            if (response.code() == 429) throw new IOException("rate-limit");
+            if (!response.isSuccessful() || response.body() == null) throw new IOException("Profile media HTTP " + response.code());
+            return response.body().string();
+        } finally {
+            call = null;
+        }
+    }
+
+    void cancel() {
+        cancelled = true;
+        Call active = call;
+        if (active != null) active.cancel();
+    }
+
+    // Replaced at patch time with direct calls into this APK's generated query/composer.
+    private static String mediaUrl(Object composer, String userId, String cursor) {
+        throw new IllegalStateException("Unpatched profile media query bridge");
+    }
+
+    private static String accountId(Object interceptor) {
+        throw new IllegalStateException("Unpatched profile account bridge");
+    }
+}
