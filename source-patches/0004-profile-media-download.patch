+    val oldLocals = (stub.implementation?.registerCount ?: 0) - stub.parameterTypes.sumOf { if (it == "J" || it == "D") 2 else 1 }
+    val method = stub.cloneMutable(additionalRegisters = maxOf(0, locals - oldLocals))
+    methods.remove(stub)
+    methods.add(method)
+    method.insertHook(0, relocateBranchTargets = false) { body(method) }
+}
