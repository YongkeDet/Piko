+        synchronized (MENU_ENTRIES) {
+            MENU_ENTRIES.removeIf(entry -> entry.item.get() == null);
+            MENU_ENTRIES.add(new MenuEntry(new WeakReference<>(item), id, handle));
+        }
+        List<Object> result = new ArrayList<>(original);
+        result.add(item);
+        return result;
+    }
+
+    public static boolean handleMenuItem(Object item) {
+        MenuEntry match = null;
+        synchronized (MENU_ENTRIES) {
+            for (MenuEntry entry : MENU_ENTRIES) if (entry.item.get() == item) { match = entry; break; }
+        }
+        if (match == null) return false;
+        MenuEntry target = match;
