+/** Prevents empty-success on native schema drift and accidental downloads of quoted media. */
+public class ProfileMediaPageTest {
+    private static JSONObject response(JSONArray instructions) throws JSONException {
+        return new JSONObject().put("data", new JSONObject().put("user_result", new JSONObject().put("result",
+                new JSONObject().put("__typename", "User").put("rest_id", "42")
+                        .put("timeline_response", new JSONObject().put("timeline", new JSONObject().put("instructions", instructions))))));
+    }
+
+    private static JSONObject image(String id, String url) throws JSONException {
+        return new JSONObject().put("id_str", id).put("media_results", new JSONObject().put("result",
+                new JSONObject().put("media_id", id).put("media_info", new JSONObject()
+                        .put("__typename", "ApiImage").put("original_img_url", url)
+                        .put("original_img_width", 4000).put("original_img_height", 3000))));
+    }
+
+    private static JSONObject post(JSONArray media) throws JSONException {
+        return new JSONObject().put("__typename", "Tweet").put("rest_id", "100")
+                .put("media_entities", media).put("details", new JSONObject().put("created_at_ms", 1700000000000L))
+                .put("core", new JSONObject().put("user_results", new JSONObject().put("result",
+                        new JSONObject().put("rest_id", "42").put("core", new JSONObject()
+                                .put("screen_name", "jack").put("name", "Jack")))));
+    }
+
+    @Test public void nativeModulesPreserveAllAttachmentsAndHighestMp4WithoutQuotedMedia() throws Exception {
+        JSONObject video = new JSONObject().put("id_str", "b").put("media_results", new JSONObject().put("result",
+                new JSONObject().put("media_id", "b").put("media_info", new JSONObject().put("__typename", "ApiVideo")
+                        .put("variants", new JSONArray()
+                                .put(new JSONObject().put("content_type", "application/x-mpegURL").put("url", "https://video.twimg.com/a.m3u8"))
+                                .put(new JSONObject().put("content_type", "video/mp4").put("bit_rate", 100).put("url", "https://video.twimg.com/low.mp4"))
+                                .put(new JSONObject().put("content_type", "video/mp4").put("bit_rate", 300).put("url", "https://video.twimg.com/high.mp4"))))));
+        JSONObject tweet = post(new JSONArray().put(image("a", "https://pbs.twimg.com/media/a?format=png&name=orig")).put(video));
+        tweet.getJSONArray("media_entities").getJSONObject(0).put("source_status_id_str", "77")
+                .put("source_user_results", new JSONObject().put("result", new JSONObject().put("core",
+                        new JSONObject().put("screen_name", "original_author").put("name", "Original Author"))));
+        tweet.put("quoted_tweet_results", new JSONObject().put("result", post(new JSONArray().put(image("quoted", "https://pbs.twimg.com/media/quoted.jpg")))));
+        JSONObject cursor = new JSONObject().put("__typename", "TimelineTimelineCursor").put("cursor_type", "Bottom").put("value", "page2");
+        String json = response(new JSONArray().put(new JSONObject().put("__typename", "TimelineAddEntries").put("entries",
+                new JSONArray().put(new JSONObject().put("content", new JSONObject().put("items", new JSONArray().put(tweet)))).put(cursor)))).toString();
+        ProfileMediaPage page = ProfileMediaPage.parse(json, "42", "fallback");
+        assertEquals(2, page.items.size());
+        assertEquals("page2", page.cursor);
+        assertEquals("png", page.items.get(0).extension);
+        assertEquals("4000x3000", page.items.get(0).resolution);
+        assertEquals("original_author", page.items.get(0).handle);
+        assertEquals("77", page.items.get(0).postId);
+        assertEquals("https://video.twimg.com/high.mp4", page.items.get(1).url);
+        assertEquals("jack", page.items.get(1).handle);
+        assertEquals(1, page.items.get(1).index);
+        assertEquals(2, page.items.get(1).count);
+        assertEquals(0, page.unavailable);
+    }
+
+    @Test public void emptyIntermediatePageRetainsCursorAndExplicitBottomTerminationWins() throws Exception {
+        JSONArray instructions = new JSONArray().put(new JSONObject().put("__typename", "TimelineTimelineCursor")
+                .put("cursorType", "Bottom").put("value", "next"));
+        ProfileMediaPage page = ProfileMediaPage.parse(response(instructions).toString(), "42", "jack");
+        assertEquals("next", page.cursor);
+        assertTrue(page.items.isEmpty());
+        instructions.put(new JSONObject().put("__typename", "TimelineTerminateTimeline").put("direction", "Bottom"));
+        assertNull(ProfileMediaPage.parse(response(instructions).toString(), "42", "jack").cursor);
+    }
+
+    @Test public void unavailableFilesAreCountedAndNonMediaUrlsAreNeverDownloaded() throws Exception {
+        JSONObject tweet = post(new JSONArray().put(image("bad", "https://pbs.twimg.com.attacker.invalid/private"))
+                .put(new JSONObject().put("media_results", new JSONObject().put("result", JSONObject.NULL))));
+        ProfileMediaPage page = ProfileMediaPage.parse(response(new JSONArray().put(tweet)).toString(), "42", "jack");
+        assertTrue(page.items.isEmpty());
+        assertEquals(2, page.unavailable);
+    }
+
+    @Test public void errorsMissingTimelineAndWrongProfileFailInsteadOfReportingFinished() throws Exception {
+        JSONObject good = response(new JSONArray());
+        assertTrue(ProfileMediaPage.parse(good.toString(), "42", "jack").items.isEmpty());
+        assertThrows(JSONException.class, () -> ProfileMediaPage.parse(good.toString(), "99", "jack"));
+        JSONObject partial = response(new JSONArray()).put("errors", new JSONArray().put(new JSONObject().put("code", 88)));
+        assertThrows(JSONException.class, () -> ProfileMediaPage.parse(partial.toString(), "42", "jack"));
+        assertThrows(JSONException.class, () -> ProfileMediaPage.parse("{\"data\":{}}", "42", "jack"));
+    }
