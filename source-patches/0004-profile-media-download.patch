+/** Native profile menu entry and a bounded, cancelable download job. */
+public final class ProfileMediaDownloader {
+    private static final List<MenuEntry> MENU_ENTRIES = new ArrayList<>();
+    private static final ExecutorService WORKER = Executors.newSingleThreadExecutor(r -> {
+        Thread thread = new Thread(r, "profile-media-download");
+        thread.setDaemon(true);
+        return thread;
+    });
+    private static volatile Job active;
