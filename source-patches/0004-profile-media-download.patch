+    private ProfileMediaDownloader() {}
+
+    private static String text(String suffix, Object... args) {
+        String value = StringRef.str("piko_newx_profile_download_" + suffix);
+        return args.length == 0 ? value : String.format(java.util.Locale.getDefault(), value, args);
+    }
+
+    public static List<?> addMenuItem(List<?> original, Object user) {
+        if (original == null || original.isEmpty() || user == null) return original;
+        String id = profileId(user), handle = profileHandle(user);
+        if (id == null || !id.matches("[0-9]+") || handle == null || !handle.matches("[A-Za-z0-9_]+")) return original;
