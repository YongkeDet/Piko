+package app.morphe.extension.newx.misc;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.net.URI;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+
+/** Parses the native profile media query, including modules and response objects. */
+final class ProfileMediaPage {
+    final List<Item> items = new ArrayList<>();
+    String cursor;
+    int unavailable;
+    private boolean terminated;
+
+    static final class Item {
+        final String key, postId, handle, name, timestamp, url, extension, mimeType, resolution;
+        final int index, count;
+
+        Item(String key, String postId, String handle, String name, String timestamp,
+             String url, String extension, String mimeType, String resolution, int index, int count) {
+            this.key = key;
+            this.postId = postId;
+            this.handle = handle;
+            this.name = name;
+            this.timestamp = timestamp;
+            this.url = url;
+            this.extension = extension;
+            this.mimeType = mimeType;
+            this.resolution = resolution;
+            this.index = index;
+            this.count = count;
+        }
+    }
+
+    static ProfileMediaPage parse(String json, String userId, String fallbackHandle) throws JSONException {
+        JSONObject root = new JSONObject(json);
+        JSONArray errors = root.optJSONArray("errors");
+        if (errors != null && errors.length() > 0) {
+            for (int i = 0; i < errors.length(); i++) {
+                JSONObject error = errors.optJSONObject(i);
+                if (error != null && (error.optInt("code") == 88 || error.optInt("code") == 429)) throw new JSONException("rate-limit");
+            }
+            throw new JSONException("Profile media query returned errors");
+        }
+        JSONObject user = root.getJSONObject("data").getJSONObject("user_result").getJSONObject("result");
+        if (!"User".equals(user.optString("__typename")) || !userId.equals(user.getString("rest_id"))) {
+            throw new JSONException("Profile is unavailable or has changed");
+        }
+        JSONObject timeline = user.getJSONObject("timeline_response").getJSONObject("timeline");
+        // Missing instructions is a schema/permission failure, never a successful empty profile.
+        timeline.getJSONArray("instructions");
+        ProfileMediaPage page = new ProfileMediaPage();
+        page.visit(timeline, userId, fallbackHandle, 0);
+        if (page.terminated) page.cursor = null;
+        return page;
+    }
+
+    private void visit(Object value, String userId, String handle, int depth) throws JSONException {
+        if (depth > 64) throw new JSONException("Profile media response is too deeply nested");
+        if (value instanceof JSONArray array) {
+            for (int i = 0; i < array.length(); i++) visit(array.opt(i), userId, handle, depth + 1);
+        } else if (value instanceof JSONObject object) {
+            String type = object.optString("__typename");
+            if ("TimelineTerminateTimeline".equals(type) && "Bottom".equalsIgnoreCase(object.optString("direction"))) {
+                terminated = true;
+                return;
+            }
+            if ("TimelineTimelineCursor".equals(type) || "TimelineCursor".equals(type)) {
+                String kind = object.optString("cursor_type", object.optString("cursorType"));
+                if ("Bottom".equalsIgnoreCase(kind)) {
+                    String next = object.optString("value");
+                    if (!next.isEmpty()) {
+                        if (cursor != null && !cursor.equals(next)) throw new JSONException("Ambiguous bottom cursor");
+                        cursor = next;
+                    }
+                }
+                return;
+            }
+            if ("Tweet".equals(type)) {
+                post(object, userId, handle);
+                return; // Quoted posts, cards, avatars and repost sources are not profile media.
+            }
+            Iterator<String> keys = object.keys();
+            while (keys.hasNext()) visit(object.opt(keys.next()), userId, handle, depth + 1);
+        }
+    }
+
+    private void post(JSONObject post, String userId, String fallbackHandle) throws JSONException {
+        String postId = post.optString("rest_id");
+        if (!postId.matches("[0-9]+")) return;
+        JSONObject author = object(object(object(post, "core"), "user_results"), "result");
+        if (author.has("rest_id") && !userId.equals(author.optString("rest_id"))) return;
+        JSONObject core = object(author, "core");
+        String handle = core.optString("screen_name", fallbackHandle);
+        String name = core.optString("name", handle);
+        String timestamp = object(post, "details").optString("created_at_ms");
+        JSONArray media = post.optJSONArray("media_entities");
+        if (media == null) return;
+        for (int i = 0; i < media.length(); i++) {
+            JSONObject entity = media.optJSONObject(i);
+            if (entity == null) continue;
+            JSONObject result = object(object(entity, "media_results"), "result");
+            JSONObject info = object(result, "media_info");
+            String type = info.optString("__typename");
+            String url = "", extension = "", mime = "", resolution = null;
+            if ("ApiImage".equals(type)) {
+                url = info.optString("original_img_url");
+                extension = imageExtension(url);
+                mime = "png".equals(extension) ? "image/png" : "webp".equals(extension) ? "image/webp" : "image/jpeg";
+                int width = info.optInt("original_img_width"), height = info.optInt("original_img_height");
+                if (width > 0 && height > 0) resolution = width + "x" + height;
+            } else if ("ApiVideo".equals(type) || "ApiGif".equals(type)) {
+                JSONArray variants = info.optJSONArray("variants");
+                long best = -1;
+                if (variants != null) for (int j = 0; j < variants.length(); j++) {
+                    JSONObject variant = variants.optJSONObject(j);
+                    if (variant == null || !"video/mp4".equals(variant.optString("content_type"))) continue;
+                    long bitrate = variant.optLong("bit_rate", 0);
+                    if (bitrate > best && mediaUrl(variant.optString("url"))) {
+                        best = bitrate;
+                        url = variant.optString("url");
+                    }
+                }
+                extension = "mp4";
+                mime = "video/mp4";
+                java.util.regex.Matcher size = java.util.regex.Pattern.compile("/(\\d{2,5}x\\d{2,5})/").matcher(url);
+                if (size.find()) resolution = size.group(1);
+            }
+            if (!mediaUrl(url)) {
+                unavailable++;
+                continue;
+            }
+            String mediaId = result.optString("media_id", result.optString("id", entity.optString("id_str")));
+            String key = mediaId.isEmpty() ? postId + ":" + i : mediaId;
+            JSONObject source = object(object(object(entity, "source_user_results"), "result"), "core");
+            String mediaHandle = source.optString("screen_name", handle);
+            String mediaName = source.optString("name", name);
+            String sourceId = entity.optString("source_status_id_str");
+            String mediaPostId = sourceId.matches("[0-9]+") ? sourceId : postId;
+            items.add(new Item(key, mediaPostId, mediaHandle, mediaName, timestamp, url, extension, mime, resolution, i, media.length()));
+        }
+    }
+
+    static boolean mediaUrl(String value) {
+        try {
+            URI uri = URI.create(value);
+            String host = uri.getHost();
+            return "https".equalsIgnoreCase(uri.getScheme()) && host != null
+                    && (host.equals("twimg.com") || host.endsWith(".twimg.com"));
+        } catch (IllegalArgumentException exception) {
+            return false;
+        }
+    }
+
+    private static String imageExtension(String url) {
+        String lower = url.toLowerCase(java.util.Locale.ROOT);
+        if (lower.contains("format=png") || lower.matches(".*\\.png(?:[?:].*)?")) return "png";
+        if (lower.contains("format=webp") || lower.matches(".*\\.webp(?:[?:].*)?")) return "webp";
+        return "jpg";
+    }
+
+    private static JSONObject object(JSONObject value, String key) {
+        JSONObject child = value.optJSONObject(key);
+        return child == null ? new JSONObject() : child;
+    }
+}
