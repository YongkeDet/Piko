+/** Native Photos/Videos controller, adapted from piko-custom with bounded progress and Piko UI. */
+public final class ProfileBulkDownload {
+    private static final String SETTING = "newx.post_actions_media.profile_bulk";
+    private static volatile Session active;
+    private static final List<RawPage> RAW_PAGES = new ArrayList<>();
+    private static final List<ComponentBinding> COMPONENTS = new ArrayList<>();
+    private static final ThreadLocal<List<?>> PENDING_PAGE = new ThreadLocal<>();
+    private static final Set<DownloadRequest> REQUESTS = Collections.newSetFromMap(new WeakHashMap<>());
+
+    private ProfileBulkDownload() { }
+
+    public static boolean isEnabled() {
+        return SettingsRegistry.getBooleanOrDefault(SETTING, false);
+    }
+
+    public static boolean isRunning() { return active != null; }
+
+    /** Native Success constructor hook: downloads must not autoplay the Videos tab behind the dialog. */
+    public static boolean allowAutoplay(Object timelineType, boolean allowed) {
+        if (!allowed || active == null || !(timelineType instanceof Enum<?> kind)) return allowed;
+        return !kind.name().equals("USER_PROFILE_PHOTOS") && !kind.name().equals("USER_PROFILE_VIDEOS");
+    }
+
+    static synchronized void markRequest(DownloadRequest request) { REQUESTS.add(request); }
+    static synchronized boolean isBatchRequest(DownloadRequest request) { return REQUESTS.contains(request); }
+
+    /** The UI callback captures a child URT component, while tab selection belongs to its parent. */
+    public static synchronized void bindComponent(Object child, Object owner) {
+        if (child == null || owner == null || child == owner) return;
+        COMPONENTS.removeIf(binding -> binding.child.get() == null || binding.owner.get() == null
+                || binding.child.get() == child);
+        COMPONENTS.add(new ComponentBinding(child, owner));
+    }
+
+    static synchronized Object ownerOf(Object component) {
+        COMPONENTS.removeIf(binding -> binding.child.get() == null || binding.owner.get() == null);
+        for (ComponentBinding binding : COMPONENTS) {
+            if (binding.child.get() == component) return binding.owner.get();
+        }
+        return component;
+    }
+
+    private static final class ComponentBinding {
+        final WeakReference<Object> child;
+        final WeakReference<Object> owner;
+        ComponentBinding(Object child, Object owner) {
+            this.child = new WeakReference<>(child);
+            this.owner = new WeakReference<>(owner);
+        }
+    }
+
+    /** Preserve the raw media for each live native Success instance before display filtering. */
+    public static void rememberPage(Object type, Object raw, Object filtered) {
+        PENDING_PAGE.remove();
+        if (!isEnabled() || raw == filtered || !(raw instanceof List<?> source)
+                || !(filtered instanceof List<?>) || !(type instanceof Enum<?> kind)) return;
+        String name = kind.name();
+        if (!name.equals("USER_PROFILE_PHOTOS") && !name.equals("USER_PROFILE_VIDEOS")) return;
+        PENDING_PAGE.set(source);
+    }
+
+    /** Called at the constructor return, after the native Success instance is initialized. */
+    public static synchronized void attachPage(Object success) {
+        List<?> source = PENDING_PAGE.get();
+        PENDING_PAGE.remove();
+        if (source == null) return;
+        RAW_PAGES.removeIf(page -> page.success.get() == null || page.success.get() == success);
+        RAW_PAGES.add(new RawPage(success, source));
+    }
+
+    /** Native copies that retain the exact items list must retain its unfiltered lineage too. */
+    public static synchronized void inheritPage(Object source, Object copy, List<?> before, List<?> after) {
+        if (before != after) return;
+        // A replacement input can itself filter down to the same shared empty list. Its own
+        // freshly captured raw page is authoritative and must not be overwritten by the source.
+        if (itemsBeforeFilters(copy, after) != after) return;
+        List<?> raw = itemsBeforeFilters(source, before);
+        if (raw == before) return;
+        RAW_PAGES.removeIf(page -> page.success.get() == null || page.success.get() == copy);
+        RAW_PAGES.add(new RawPage(copy, raw));
+    }
+
+    static synchronized List<?> itemsBeforeFilters(Object success, List<?> visible) {
+        RAW_PAGES.removeIf(page -> page.success.get() == null);
+        for (int i = RAW_PAGES.size() - 1; i >= 0; i--) {
+            RawPage page = RAW_PAGES.get(i);
+            if (page.success.get() == success) return page.raw;
+        }
+        return visible;
+    }
+
+    private static final class RawPage {
+        final WeakReference<Object> success;
+        final List<?> raw;
+        RawPage(Object success, List<?> raw) { this.success = new WeakReference<>(success); this.raw = raw; }
+    }
+
+    public static void start(Context context, Object callback) {
+        Activity activity = NewXUtils.findUsableActivity(context);
+        if (activity == null || !isEnabled()) return;
+        Session running = active;
+        if (running != null) { running.sheet.show(); return; }
+        try {
+            Object component = componentOf(callback);
+            List<?> tabs = availableTabs(component);
+            Object photos = null, videos = null;
+            if (tabs != null) for (Object tab : tabs) {
+                if (tab instanceof Enum<?> value) {
+                    if (value.name().equals("Photos")) photos = tab;
+                    if (value.name().equals("Videos")) videos = tab;
+                }
+            }
+            if (photos == null && videos == null) { NewXInAppNotification.show(text("unavailable")); return; }
+            showChoices(activity, component, photos, videos);
+        } catch (RuntimeException error) {
+            NewXLogger.printException(() -> "Cannot open native profile download", error);
+            NewXInAppNotification.show(text("read_failed"));
+        }
+    }
+
+    private static void showChoices(Activity activity, Object component, Object photos, Object videos) {
+        BottomSheetView choices = new BottomSheetView(activity).setTitle(text("button"))
+                .setSubtitle(text("description"));
+        LinearLayout body = new LinearLayout(activity);
+        body.setOrientation(LinearLayout.VERTICAL);
+        String[] labels = {"all", "images", "videos"};
+        IconView.IconType[] icons = {IconView.IconType.DOWNLOAD, IconView.IconType.IMAGE, IconView.IconType.VIDEO};
+        for (int i = 0; i < labels.length; i++) {
+            final int kind = i;
+            ListItem row = new ListItem(activity);
+            row.setTitle(text(labels[i]));
+            row.setLeadingIcon(icons[i], Theme.primaryText(activity), null);
+            boolean available = kind == 0 ? photos != null && videos != null : kind == 1 ? photos != null : videos != null;
+            row.setEnabled(available);
+            row.setAlpha(available ? 1f : 0.4f);
+            row.setOnClickListener(view -> {
+                choices.dismiss();
+                new Handler(Looper.getMainLooper()).post(() -> begin(activity, component, photos, videos, kind));
+            });
+            body.addView(row);
+        }
+        choices.setScrollableBodyView(body).show();
+    }
+
+    private static void begin(Activity activity, Object component, Object photos, Object videos, int kind) {
+        if (active != null) { active.sheet.show(); return; }
+        boolean imagesMissing = kind != 2 && !NewXDownloadFolders.isConfigured(activity, NewXDownloadFolders.MediaKind.IMAGES);
+        boolean videosMissing = kind != 1 && !NewXDownloadFolders.isConfigured(activity, NewXDownloadFolders.MediaKind.VIDEOS);
+        if (imagesMissing || videosMissing) {
+            NewXInAppNotification.show(text("folder_required"));
+            NewXDownloadFolders.choose(activity, imagesMissing ? NewXDownloadFolders.MediaKind.IMAGES : NewXDownloadFolders.MediaKind.VIDEOS);
+            return;
+        }
+        try {
+            Session session = new Session(activity, component, photos, videos, kind);
+            active = session;
+            session.begin();
+        } catch (RuntimeException error) {
+            NewXLogger.printException(() -> "Cannot start native profile download", error);
+            Session session = active;
+            if (session != null) session.stop("read_failed");
+            else NewXInAppNotification.show(text("read_failed"));
+        }
+    }
+
+    private static final class Session {
+        final Activity activity;
+        final Context context;
+        final Object component, originalTab, photos, videos;
+        final int kind;
+        final Handler main = new Handler(Looper.getMainLooper());
+        final ExecutorService worker = Executors.newSingleThreadExecutor();
+        final Set<String> mediaKeys = new HashSet<>(), phaseKeys = new HashSet<>();
+        final List<DownloadHandle> transfers = new ArrayList<>();
+        final BottomSheetView sheet;
+        final TextView status;
+        final ButtonView cancel, close;
+        ProfileBulkPager pager = new ProfileBulkPager(SystemClock.elapsedRealtime());
+        Object desiredTab;
+        volatile boolean stopped;
+        volatile int saved, skipped, failed, unavailable, discovered;
+        boolean processing, recovering, finished, protectedStop;
+        String endReason;
+        int pages;
+
+        Session(Activity activity, Object component, Object photos, Object videos, int kind) {
+            this.activity = activity;
+            this.context = activity.getApplicationContext();
+            this.component = component;
+            this.originalTab = selectedTab(component);
+            this.photos = photos;
+            this.videos = videos;
+            this.kind = kind;
+            this.desiredTab = kind == 2 ? videos : photos;
+            sheet = new BottomSheetView(activity).setTitle(text("button")).setSubtitle(text("keep_open"));
+            LinearLayout body = new LinearLayout(activity);
+            body.setOrientation(LinearLayout.VERTICAL);
+            int padding = Theme.dpToPx(activity, 20);
+            body.setPadding(padding, 0, padding, padding);
+            status = new TextView(activity);
+            status.setTypeface(UpdateFont.customTypefaceOr(android.graphics.Typeface.DEFAULT));
+            status.setTextColor(Theme.primaryText(activity));
+            status.setTextSize(15);
+            body.addView(status);
+            sheet.setBodyView(body).setCanceledOnTouchOutside(false);
+            cancel = new ButtonView(activity, ButtonView.ButtonStyle.TONAL, text("cancel"));
+            cancel.setOnClickListener(view -> stop("cancelled"));
+            sheet.addButton(cancel);
+            close = new ButtonView(activity, ButtonView.ButtonStyle.FILLED, text("close"));
+            close.setVisibility(View.GONE);
+            close.setOnClickListener(view -> sheet.dismiss());
+            sheet.addButton(close);
+            sheet.getDialog().setOnDismissListener(ignored -> { if (!finished) stop("cancelled"); });
+        }
+
+        void begin() {
+            sheet.show();
+            if (sheet.getDialog().getWindow() != null) sheet.getDialog().getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+            selectTab(component, desiredTab);
+            updateProgress();
+            main.post(this::tick);
+        }
+
+        void tick() {
+            if (finished) return;
+            if (activity.isDestroyed() || activity.isFinishing()) { stop("cancelled"); return; }
+            updateProgress();
+            if (stopped) { if (!processing) finish(); return; }
+            if (processing) { main.postDelayed(this::tick, 500); return; }
+            try {
+                if (selectedTab(component) != desiredTab) { stop("tab_changed"); return; }
+                List<?> items = currentItems(component);
+                Object[] snapshot = pagingSnapshot(component);
+                if (snapshot == null || snapshot.length != 6) throw new IllegalStateException("Missing native paging state");
+                String cursor = (String) snapshot[3];
+                ProfileBulkPager.Network network = ProfileBulkPager.Network.read(snapshot[4]);
+                ProfileBulkPager.Step step = pager.step(SystemClock.elapsedRealtime(), items,
+                        Boolean.TRUE.equals(snapshot[0]), Boolean.TRUE.equals(snapshot[1]),
+                        Boolean.TRUE.equals(snapshot[2]), cursor, network, Boolean.TRUE.equals(snapshot[5]));
+                switch (step) {
+                    case PROCESS -> {
+                        recovering = false;
+                        processing = true;
+                        worker.execute(() -> process(items, cursor));
+                    }
+                    case NEXT, RETRY -> {
+                        recovering = step == ProfileBulkPager.Step.RETRY;
+                        pager.requested(cursor, SystemClock.elapsedRealtime(), network);
+                        requestNext(component);
+                    }
+                    case REFRESH -> {
+                        recovering = true;
+                        // Refresh intentionally rereads old pages; only pagination progress resets.
+                        phaseKeys.clear();
+                        pager.refreshed(SystemClock.elapsedRealtime(), cursor, network);
+                        refresh(component);
+                    }
+                    case STOPPED -> { protectedStop = true; advancePhase(); if (finished) return; }
+                    case DONE -> { advancePhase(); if (finished) return; }
+                    case FAILED -> {
+                        NewXLogger.printInfo(() -> "Profile pagination stopped: " + pager.failure()
+                                + ", HTTP=" + pager.failureStatus() + ", attempts=" + pager.attempts());
+                        stop(switch (pager.failure()) {
+                            case ACCESS -> "access_failed";
+                            case RATE_LIMIT -> "rate_limited";
+                            case CURSOR_LOOP -> "cursor_stalled";
+                            case NETWORK -> "network_failed";
+                            case TIMEOUT -> "timed_out";
+                            case NONE -> "read_failed";
+                        });
+                        return;
+                    }
+                    case WAIT -> { }
+                }
+            } catch (RuntimeException error) {
+                NewXLogger.printException(() -> "Native profile pagination stopped", error);
+                stop("read_failed");
+                return;
+            }
+            main.postDelayed(this::tick, 500);
+        }
+
+        void advancePhase() {
+            if (kind == 0 && desiredTab == photos) {
+                desiredTab = videos;
+                phaseKeys.clear();
+                pager = new ProfileBulkPager(SystemClock.elapsedRealtime());
+                selectTab(component, videos);
+            } else {
+                endReason = protectedStop ? "pagination_stopped" : "completed";
+                finish();
+            }
+        }
+
+        void process(List<?> items, String cursor) {
+            boolean progressed = false;
+            try {
+                for (Object item : NewXTimelineFilter.mediaItemsForProfileDownload(items)) {
+                    if (stopped) break;
+                    try {
+                        List<?> media = ProfilePhotosGallery.getDownloadMedia(item);
+                        if (media == null || media.isEmpty()) continue;
+                        DownloadFileName.PostContext post = DownloadFileName.PostContext.from(item);
+                        for (int index = 0; index < media.size() && !stopped; index++) {
+                            Object raw = media.get(index);
+                            List<InlineDownloadButton.DownloadItem> parsed = InlineDownloadButton.downloadItems(Collections.singletonList(raw));
+                            InlineDownloadButton.DownloadItem download = parsed.isEmpty() ? null : parsed.get(0);
+                            String candidate = candidateKey(raw, download, post, index);
+                            boolean newCandidate = candidate != null && phaseKeys.add(candidate);
+                            progressed |= newCandidate;
+                            if (download == null) { if (newCandidate) unavailable++; continue; }
+                            boolean image = download.mimeType.startsWith("image/");
+                            if (kind == 1 && !image || kind == 2 && image) continue;
+                            String key = InlineDownloadButton.urlKey(download.url);
+                            if (!mediaKeys.add(key)) continue;
+                            discovered++;
+                            drain(false);
+                            if (stopped) break;
+                            InlineDownloadButton.DownloadItem chosen = InlineDownloadButton.autoSelectedOption(download);
+                            if (chosen == null) chosen = download;
+                            EnqueueResult result = InlineDownloadButton.enqueueProfileDownload(context, chosen, post,
+                                    post.screenName, index, media.size());
+                            switch (result.state()) {
+                                case QUEUED -> {
+                                    synchronized (transfers) { transfers.add(result.handle()); }
+                                    if (stopped) result.handle().cancel();
+                                }
+                                case SKIPPED -> skipped++;
+                                case FAILED -> failed++;
+                                case DESTINATION_LOST -> { failed++; endReason = "folder_required"; stopped = true; }
+                            }
+                        }
+                    } catch (RuntimeException error) {
+                        failed++;
+                        NewXLogger.printException(() -> "Cannot read one profile media item", error);
+                    }
+                }
+                drain(true);
+            } catch (RuntimeException error) {
+                NewXLogger.printException(() -> "Profile downloads stopped", error);
+                endReason = "read_failed";
+                stopped = true;
+                cancelTransfers();
+            } finally {
+                final boolean newMedia = progressed;
+                main.post(() -> {
+                    processing = false;
+                    pages++;
+                    pager.processed(items, cursor, SystemClock.elapsedRealtime(), newMedia);
+                    if (stopped) finish();
+                });
+            }
+        }
+
+        void drain(boolean all) {
+            while (true) {
+                int remaining;
+                synchronized (transfers) {
+                    Iterator<DownloadHandle> iterator = transfers.iterator();
+                    while (iterator.hasNext()) {
