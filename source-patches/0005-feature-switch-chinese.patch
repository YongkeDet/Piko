@@ -0,0 +1,36 @@
+package app.morphe.extension.newx.featureswitches;
+
+import android.content.Context;
+import android.content.res.Resources;
+import java.util.Locale;
+import java.util.concurrent.ConcurrentHashMap;
+
+/** Display aliases only. Repository keys, observations and persisted values stay untouched. */
+final class FeatureSwitchLabels {
+    private static final ConcurrentHashMap<String, Integer> IDS = new ConcurrentHashMap<>();
+    private FeatureSwitchLabels() { }
+
+    static String title(Context context, String key) {
+        if (key == null || key.isEmpty()) return "";
+        // Only exact catalog keys map to resources. Future keys keep their original spelling.
+        if (!key.matches("[a-z][a-z0-9_]+")) return key;
+        try {
+            int id = IDS.computeIfAbsent(key, name -> context.getResources().getIdentifier(
+                    "piko_newx_fs_" + name, "string", context.getPackageName()));
+            return id == 0 ? key : context.getString(id);
+        } catch (Resources.NotFoundException ignored) {
+            return key;
+        }
+    }
+
+    static boolean matches(Context context, String key, String query) {
+        String needle = query == null ? "" : query.trim().toLowerCase(Locale.ROOT);
+        return needle.isEmpty() || key.toLowerCase(Locale.ROOT).contains(needle)
+                || title(context, key).toLowerCase(Locale.ROOT).contains(needle);
+    }
+
+    static String editorSubtitle(Context context, String key) {
+        String title = title(context, key);
+        return title.equals(key) ? key : title + "\n" + key;
+    }
+}
